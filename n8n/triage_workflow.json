{
  "id": "upiTriageInbox01",
  "name": "UPI statement triage",
  "nodes": [
    {
      "id": "6b0f2b0e-0001-4c51-9a40-000000000001",
      "name": "Statement arrives in inbox",
      "type": "n8n-nodes-base.localFileTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {
        "triggerOn": "folder",
        "path": "/data/inbox",
        "events": ["add"],
        "options": { "usePolling": true, "awaitWriteFinish": true }
      }
    },
    {
      "id": "6b0f2b0e-0002-4c51-9a40-000000000002",
      "name": "Read CSV file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [220, 0],
      "parameters": { "operation": "read", "fileSelector": "={{ $json.path }}", "options": {} }
    },
    {
      "id": "6b0f2b0e-0003-4c51-9a40-000000000003",
      "name": "Parse rows",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [440, 0],
      "parameters": { "operation": "csv", "options": {} }
    },
    {
      "id": "6b0f2b0e-0004-4c51-9a40-000000000004",
      "name": "Build triage payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": {
        "jsCode": "// One request per statement file. Only the columns the agent may see are sent.\nconst rows = $input.all().map(i => i.json).filter(r => r.txn_id && r.narration);\nconst file = $('Statement arrives in inbox').first().json.path || 'statement.csv';\nconst statementId = rows[0]?.statement_id || file.split('/').pop().replace(/\\.csv$/i, '');\nreturn [{ json: {\n  statement_id: statementId,\n  rows: rows.map(r => ({ txn_id: r.txn_id, narration: r.narration, debit: r.debit ?? '', credit: r.credit ?? '' })),\n} }];"
      }
    },
    {
      "id": "6b0f2b0e-0005-4c51-9a40-000000000005",
      "name": "POST /triage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/triage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": { "timeout": 600000 }
      }
    },
    {
      "id": "6b0f2b0e-0006-4c51-9a40-000000000006",
      "name": "Anything to review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "6b0f2b0e-0007-4c51-9a40-000000000007",
              "leftValue": "={{ $json.to_review }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6b0f2b0e-0008-4c51-9a40-000000000008",
      "name": "Build review alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, -100],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst text = `Statement ${r.statement_id}: ${r.to_review} of ${r.processed} transactions need review ` +\n  `(${r.auto} categorized automatically, agent used: ${r.agent_used}, cost $${r.cost_usd}). Review: ${r.review_url}`;\nreturn [{ json: { text, ...r } }];"
      }
    },
    {
      "id": "6b0f2b0e-0009-4c51-9a40-000000000009",
      "name": "Send Slack alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, -100],
      "disabled": true,
      "notes": "Enable and paste your Slack incoming-webhook URL (or swap for an Email / Telegram node).",
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Statement arrives in inbox": { "main": [[{ "node": "Read CSV file", "type": "main", "index": 0 }]] },
    "Read CSV file": { "main": [[{ "node": "Parse rows", "type": "main", "index": 0 }]] },
    "Parse rows": { "main": [[{ "node": "Build triage payload", "type": "main", "index": 0 }]] },
    "Build triage payload": { "main": [[{ "node": "POST /triage", "type": "main", "index": 0 }]] },
    "POST /triage": { "main": [[{ "node": "Anything to review?", "type": "main", "index": 0 }]] },
    "Anything to review?": { "main": [[{ "node": "Build review alert", "type": "main", "index": 0 }], []] },
    "Build review alert": { "main": [[{ "node": "Send Slack alert", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "pinData": {}
}
