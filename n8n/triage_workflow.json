{
  "id": "upiTriageInbox01",
  "name": "UPI statement triage",
  "nodes": [
    {
      "id": "6b0f2b0e-0001-4c51-9a40-000000000001",
      "name": "Statement arrives in inbox",
      "type": "n8n-nodes-base.localFileTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {
        "triggerOn": "folder",
        "path": "/data/inbox",
        "events": ["add"],
        "options": { "usePolling": true, "awaitWriteFinish": true }
      }
    },
    {
      "id": "6b0f2b0e-0002-4c51-9a40-000000000002",
      "name": "Read statement file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [220, 0],
      "parameters": { "operation": "read", "fileSelector": "={{ $json.path }}", "options": {} }
    },
    {
      "id": "6b0f2b0e-0005-4c51-9a40-000000000005",
      "name": "POST /triage/file",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "notes": "Uploads the file as-is. The API reads any bank's CSV / XLS / XLSX export (or the pipeline's CSV), so this workflow does not parse anything itself.",
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/triage/file",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "data" }
          ]
        },
        "options": { "timeout": 600000 }
      }
    },
    {
      "id": "6b0f2b0e-0006-4c51-9a40-000000000006",
      "name": "Anything to review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "6b0f2b0e-0007-4c51-9a40-000000000007",
              "leftValue": "={{ $json.to_review }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6b0f2b0e-0008-4c51-9a40-000000000008",
      "name": "Build review alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, -100],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst text = `${r.filename} (statement ${r.statement_id}): ${r.to_review} of ${r.processed} transactions need review ` +\n  `(${r.auto} categorized automatically, agent used: ${r.agent_used}, privacy: ${r.privacy}, cost $${r.cost_usd}). Review: ${r.review_url}`;\nreturn [{ json: { text, ...r } }];"
      }
    },
    {
      "id": "6b0f2b0e-0009-4c51-9a40-000000000009",
      "name": "Send Slack alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -100],
      "disabled": true,
      "notes": "Enable and paste your Slack incoming-webhook URL (or swap for an Email / Telegram node).",
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Statement arrives in inbox": { "main": [[{ "node": "Read statement file", "type": "main", "index": 0 }]] },
    "Read statement file": { "main": [[{ "node": "POST /triage/file", "type": "main", "index": 0 }]] },
    "POST /triage/file": { "main": [[{ "node": "Anything to review?", "type": "main", "index": 0 }]] },
    "Anything to review?": { "main": [[{ "node": "Build review alert", "type": "main", "index": 0 }], []] },
    "Build review alert": { "main": [[{ "node": "Send Slack alert", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "pinData": {}
}
