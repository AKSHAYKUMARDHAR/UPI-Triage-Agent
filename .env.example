# Claude credentials for the agent (Versions B/C). Without them the pipeline runs as Version A.
ANTHROPIC_API_KEY=

# Agent settings
LLM_MODEL=claude-sonnet-5-5      # used for the B/C eval runs; any model in agent/loop.py PRICES is costed
LLM_EFFORT=low                   # low | medium | high (per-row classification needs little)
AGENT_CONCURRENCY=6              # rows sent to Claude in parallel
AGENT_MIN_CONFIDENCE=0.7         # agent answers below this still go to review
AGENT_ENABLED=auto               # auto = on when credentials exist | true | false
TOOLS_TRANSPORT=stdio            # stdio = MCP server as a subprocess | inproc = same server in-process

# Confidence gate: rows below this go to the agent / review queue (chosen from the eval sweep)
CONFIDENCE_GATE=0.84

# Postgres (matches docker-compose.yml; host port 5433 avoids clashing with a local Postgres)
DATABASE_URL=postgresql://triage:triage@localhost:5433/triage

# MCP server review sink when used from Claude Code: auto | postgres | jsonl | none
REVIEW_SINK=auto
# RAG backend: auto (pgvector when indexed, else local numpy index) | pg | local
RAG_BACKEND=auto
